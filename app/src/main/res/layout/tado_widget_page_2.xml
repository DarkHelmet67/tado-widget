<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutWidgetPage2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    android:orientation="horizontal"
    tools:background="@android:color/darker_gray"
    tools:layout_height="@dimen/widget_height">

    <ImageView
        android:id="@+id/imageViewIcon2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="2"
        android:padding="@dimen/widget_padding"
        android:scaleType="centerInside"
        android:src="@drawable/hand_bar_white" />


    <TextView
        android:id="@+id/textViewInsideTemp2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="5"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="99.9°"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_large"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutRefresh2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="2"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/imageViewPhase2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chart_icon_heating"
            android:visibility="invisible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewSetPointTemp2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="center_horizontal|top"
            android:maxLines="1"
            android:text="00.0°"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_normal"
            android:textStyle="normal" />
    </LinearLayout>
</LinearLayout>
